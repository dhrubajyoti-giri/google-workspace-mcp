# Caddy reverse proxy for the Google Workspace MCP
#
# Proxies ALL traffic (including /mcp/*) to the MCP container.
# /mcp/* security is enforced by MCPAuthMiddleware in the MCP server
# itself: bearer-token (JWT) auth is required for all MCP JSON-RPC
# methods except server/discover (pre-auth negotiation per MCP 2026-07-28 spec).
#
# Public endpoints:
#   OAuth discovery: /.well-known/oauth-authorization-server
#   OAuth flows:     /authorize /token /register /revoke
#   OAuth web UI:    /oauth/scale /oauth/callback
#   MCP endpoint:    /mcp/ (requires MCP bearer token)
#   Health:          /healthz, /
#
# Copy this domain block into your Caddy instance and set
# YOUR_DOMAIN_HERE to your EXTERNAL_URL domain (e.g. mcp.example.com).

YOUR_DOMAIN_HERE {
    # Proxy all traffic to the MCP container
    reverse_proxy google-workspace-mcp:8000 {
        transport http {
            read_buffer 16mb
            response_header_up X-Served-By "caddy-google-workspace-mcp"
        }
    }

    # Health check (no auth, cache-busted)
    @health {
        path /healthz
    }
    handle_path @health {
        reverse_proxy google-workspace-mcp:8000
        header Cache-Control "no-cache"
    }

    encode zstd gzip
}
