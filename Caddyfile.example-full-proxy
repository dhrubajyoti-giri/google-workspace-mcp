# ═════════════════════════════════════════════════════════════
# Caddy reverse proxy — FULL PROXY mode (OPTIONAL alternative)
#
# This is the FULL-PROXY alternative: /mcp/* is exposed publicly
# with bearer-token auth. Enable ONLY if your MCP clients connect
# through the public URL rather than via localhost.
#
# In the default Caddyfile, /mcp/* is blocked from the public
# internet — MCP clients connect to localhost:8000/mcp/.
# ═════════════════════════════════════════════════════════════

YOUR_DOMAIN_HERE {
    # Proxy all traffic to the MCP container
    reverse_proxy google-workspace-mcp:8000 {
        transport http {
            read_buffer 16mb
        }
        header_up X-Served-By "caddy-google-workspace-mcp"
    }

    # Health check (no auth)
    @health {
        path /healthz
    }
    handle @health {
        reverse_proxy google-workspace-mcp:8000
        header Cache-Control "no-cache"
    }

    encode zstd gzip
}
