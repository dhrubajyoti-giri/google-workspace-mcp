# ═════════════════════════════════════════════════════════════
# Google Workspace MCP — Environment Configuration Template
# Copy to .env and customize:
#   cp .env.example .env
#   # edit .env: set EXTERNAL_URL, MCP_JWT_SECRET, SECRETS_VOLUME_PATH, MCP_PORT
#
# All values are read at runtime — nothing is baked into the
# Docker image except code.  Secrets stay in .env only; .env is
# in .gitignore.
# ═════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ── External URL (for OAuth callbacks) ───────────────────────────
# Must be a publicly reachable HTTPS URL behind a TLS proxy (Caddy, nginx, etc.).
# The MCP client discovers OAuth endpoints here via:
#   GET {EXTERNAL_URL}/.well-known/oauth-authorization-server
# Set this to your domain. Example: https://mcp.example.com
EXTERNAL_URL=https://mcp.example.com

# ── MCP JWT secret (for signing MCP access/refresh tokens) ────────
# Used to sign the JWTs that MCP clients use as bearer tokens.
# Must be the same value every time the container restarts (tokens
# are in-memory and will be invalidated on restart, but the secret
# must be stable for token verification within a session).
# Generate one: openssl rand -hex 32
MCP_JWT_SECRET=replace-with-strong-random-secret

# ── Google OAuth credentials ─────────────────────────────────────
# Path inside the container where client_secret.json is mounted.
# The secrets volume is mounted at /secrets (see docker-compose.yml).
# Place your Google Cloud OAuth client_secret.json at:
#   {SECRETS_VOLUME_PATH}/client_secret.json
# It will appear inside the container at /secrets/client_secret.json
GOOGLE_CLIENT_SECRET_FILE=/secrets/client_secret.json
GOOGLE_CREDENTIALS_DIR=/secrets

# ── Token registry (replaces token.json) ─────────────────────────
# JSON file storing per-user Google OAuth tokens + granted scopes.
# Auto-populated when users complete the OAuth flow via MCP client
# or via the MCP client "authorize" button. Do NOT create this file
# manually — it is auto-generated on first OAuth completion.
GOOGLE_REGISTRY_FILE=/secrets/registry.json

# ── Google API scopes (SINGLE env var) ────────────────────────
# The list of Google API scopes you have ENABLED in your GCP project.
# These are sent to Google's consent page during OAuth.
#
# Identity scopes (openid, userinfo.email, userinfo.profile) are always
# included automatically -- do NOT list them here.
#
# Read-only vs write is auto-detected: any scope containing "readonly"
# in the name is treated as read-only (shown green in the scope chooser).
#
# Format: comma-separated or space-separated Google scope URLs.
# If left empty, defaults to identity scopes only (openid, email, profile) --
# MCP tools will NOT work until you set this to enable Google API access.
#
# Google has NO API to dynamically discover which scopes a GCP project has
# enabled. Check Cloud Console -> IAM & Admin -> APIs & Services -> Enabled APIs,
# then copy the scope URLs you need from the list below.
#
# ── All Google Workspace API scopes (commented — copy what you need) ──
#
# Gmail:
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/gmail.compose,https://www.googleapis.com/auth/gmail.metadata,https://www.googleapis.com/auth/gmail.settings.basic,https://www.googleapis.com/auth/gmail.labels,https://www.googleapis.com/auth/gmail.insert
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/gmail.send
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/gmail.metadata
#
# Drive (read-only — recommended minimum):
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/drive.readonly
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/drive.readonly,https://www.googleapis.com/auth/drive.file
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/drive
#
# Docs:
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/documents.readonly
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/documents.readonly,https://www.googleapis.com/auth/documents
#
# Sheets:
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/spreadsheets.readonly
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/spreadsheets.readonly,https://www.googleapis.com/auth/spreadsheets
#
# Calendar:
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/calendar.readonly
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/calendar.readonly,https://www.googleapis.com/auth/calendar
#
# Slides:
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/presentations.readonly
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/presentations.readonly,https://www.googleapis.com/auth/presentations
#
# Contacts:
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/contacts.readonly
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/contacts.readonly,https://www.googleapis.com/auth/contacts
#
# Tasks:
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/tasks.readonly
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/tasks.readonly,https://www.googleapis.com/auth/tasks
#
# Pre-built combos (ready to copy):
#   # Gmail + Drive + Calendar (read-only)
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/drive.readonly,https://www.googleapis.com/auth/calendar.readonly
#   # Gmail + Drive + Calendar + Docs + Sheets + Slides (read-only)
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/drive.readonly,https://www.googleapis.com/auth/documents.readonly,https://www.googleapis.com/auth/spreadsheets.readonly,https://www.googleapis.com/auth/calendar.readonly,https://www.googleapis.com/auth/presentations.readonly
#   # Full access (all read + write)
#   AVAILABLE_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/gmail.compose,https://www.googleapis.com/auth/gmail.metadata,https://www.googleapis.com/auth/gmail.settings.basic,https://www.googleapis.com/auth/gmail.labels,https://www.googleapis.com/auth/gmail.insert,https://www.googleapis.com/auth/drive,https://www.googleapis.com/auth/drive.file,https://www.googleapis.com/auth/documents,https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/presentations,https://www.googleapis.com/auth/contacts,https://www.googleapis.com/auth/tasks
#
# Set your chosen scopes below (uncomment one of the above or write your own):
AVAILABLE_SCOPES=

# ── MCP server info ──────────────────────────────────────────────
MCP_SERVER_NAME=google-workspace-mcp
MCP_SERVER_VERSION=1.0.0

# ── Token lifetimes (seconds) ───────────────────────────────────
# MCP access tokens (sent as Bearer tokens on /mcp/* requests)
MCP_ACCESS_TOKEN_TTL=28800     # 8 hours
# MCP refresh tokens (used to get new access tokens without re-auth)
MCP_REFRESH_TOKEN_TTL=2592000  # 30 days
# MCP authorization codes (short-lived, exchanged at /token)
MCP_AUTH_CODE_TTL=600          # 10 minutes

# ── Host volume path for persistent secrets ──────────────────────
# Point this at the host directory that will hold client_secret.json
# and registry.json. The volume is mounted at /secrets in the container.
# Example: /home/user/google-workspace-mcp-secrets
SECRETS_VOLUME_PATH=/path/to/secrets

# ── Scope selection mode ──────────────────────────────────────
# "all"       -> send ALL AVAILABLE_SCOPES to Google's consent page
#                (user accepts/denies all in one Google click)
# "requested" -> send only the scopes the MCP client explicitly requested
#                (Google shows only those -- narrower consent screen)
# No scope selection form is shown -- Google's consent page is the selector.
SCOPE_SELECTOR_MODE=all

# ── Additional allowed hosts (DNS rebinding protection) ─────────────
# Comma-separated list of Host header values to accept on /mcp/* (in addition
# to the EXTERNAL_URL domain and localhost/127.0.0.1).
#
# Only set this if your MCP client connects directly to the container
# (not via the external HTTPS URL). Common scenarios:
#
# Public access via Caddy/domain (most common):
#   MCP client hits https://<your-domain>/mcp → no setting needed
#   (EXTERNAL_URL domain is auto-allowed)
#
# Docker internal network:
#   MCP client hits http://gws-mcp:8000/mcp → set:
#   MCP_ALLOWED_HOSTS=gws-mcp,gws-mcp:*
#   (replace gws-mcp with your actual Docker service/container name)
#
# Local development:
#   MCP client hits http://localhost:8000/mcp → no setting needed
#   (localhost is auto-allowed)
MCP_ALLOWED_HOSTS=

# ── Other ───────────────────────────────────────────────────────
TZ=Asia/Kolkata
LOG_LEVEL=INFO
