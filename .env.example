# ════════════════════════════════════════════════════════════════
# Google API Bridge — Environment Configuration Template
# ════════════════════════════════════════════════════════════════
# Copy to .env and customize:
#   cp .env.example .env
#   # edit .env: set EXTERNAL_URL to your public HTTPS domain
#
# All values are read at runtime — nothing is baked into the
# Docker image except code.  Secrets (AUTH_TOKEN, VOLUME_PATH)
# stay in .env only; .env is in .gitignore.
# ════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ── External URL (for OAuth callbacks) ───────────────────────────
# Must be a publicly reachable HTTPS URL behind Caddy (or another TLS proxy).
# Caddy will terminate TLS and proxy /mcp + /oauth/* to this container.
EXTERNAL_URL=https://your-domain.mcp.dg.linkpc.net

# ── Google OAuth credentials ────────────────────────────────────
# Mount your Google Cloud "client_secret.json" at this path inside the container.
# Place the file at secrets/client_secret.json on the host.
GOOGLE_CLIENT_SECRET_FILE=/config/client_secret.json

# Where to store the refresh token (persistent volume).
GOOGLE_TOKEN_FILE=/config/token.json
GOOGLE_CREDENTIALS_DIR=/config

# ── Google API scopes ────────────────────────────────────────
# Full-access scopes (read + write) — needed for tools that send email,
# create files, edit docs, manage calendars, etc.
# Excludes: Custom Search API, Apps Script API (per project scope).
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/gmail.compose,https://www.googleapis.com/auth/gmail.metadata,https://www.googleapis.com/auth/gmail.settings.basic,https://www.googleapis.com/auth/gmail.labels,https://www.googleapis.com/auth/gmail.insert,https://www.googleapis.com/auth/drive,https://www.googleapis.com/auth/drive.file,https://www.googleapis.com/auth/drive.readonly,https://www.googleapis.com/auth/documents,https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/presentations,https://www.googleapis.com/auth/contacts,https://www.googleapis.com/auth/forms.body,https://www.googleapis.com/auth/forms.responses,https://www.googleapis.com/auth/tasks,https://www.googleapis.com/auth/chat.bot,https://www.googleapis.com/auth/chat.messages,https://www.googleapis.com/auth/chat.spaces,openid,https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/userinfo.profile

# ── Read-only alternative (uncomment to restrict) ─────────────
# GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/drive.readonly,https://www.googleapis.com/auth/documents.readonly,https://www.googleapis.com/auth/spreadsheets.readonly,https://www.googleapis.com/auth/calendar.readonly,https://www.googleapis.com/auth/presentations.readonly,https://www.googleapis.com/auth/contacts.readonly,https://www.googleapis.com/auth/tasks.readonly,openid,https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/userinfo.profile

# ── MCP server info ─────────────────────────────────────────────
MCP_SERVER_NAME=google-api-bridge
MCP_SERVER_VERSION=1.0.0

# ── Auth token (security) ──────────────────────────────────────
# Static secret sent by QwenPaw as "Authorization: Bearer <token>" on /mcp requests.
# Must match AUTH_TOKEN set in QwenPaw's environment.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=REPLACE_WITH_SECRETS_TOKEN_URL_SAFE_32

# ── Host volume path for persistent secrets ─────────────────────
# Point this at the host directory that will hold client_secret.json + token.json.
VOLUME_PATH=/home/ubuntu/volumes/google-api

# ── Other ───────────────────────────────────────────────────────
TZ=Asia/Kolkata
LOG_LEVEL=INFO
