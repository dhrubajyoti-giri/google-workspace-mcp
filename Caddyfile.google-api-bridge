# Caddy reverse proxy for Google API Bridge
# Add this domain block to your Caddy instance on the `caddy` Docker network.
# The domain comes from the EXTERNAL_URL in .env (default: google-api.mcp.dg.linkpc.net)
#
# To enable:  echo "import Caddyfile.google-api-bridge" >> /path/to/Caddyfile
# Or:         caddy fmt --overwrite Caddyfile.google-api-bridge && caddy reload

# ── TLS is handled automatically by Caddy (existing setup) ──
# Domain comes from the EXTERNAL_URL in .env
google-api.mcp.dg.linkpc.net {
    # Proxy all traffic to the bridge container
    reverse_proxy google-api:8000 {
        transport http {
            read_buffer 16mb
            response_header_up X-Served-By "caddy-google-api-bridge"
        }
    }

    # Health check
    @health {
        path /healthz
    }
    handle_path @health {
        reverse_proxy google-api:8000
        header Cache-Control "no-cache"
    }

    encode zstd gzip
    file_server
}
